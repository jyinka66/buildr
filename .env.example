# Copy to .env and replace every placeholder. Never commit real secrets.
NODE_ENV=production
# Set true only if the hosting proxy overwrites incoming X-Forwarded-For/X-Real-IP headers.
TRUST_PROXY_HEADERS=false
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-output
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-public-anon-key
ENCRYPTION_KEY=replace-with-64-hex-characters
SIDECAR_URL=http://localhost:3030
SIDECAR_AUTH_TOKEN=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://your-domain.example
ALLOWED_FRAME_ANCESTORS="'self'"
PAYSTACK_MODE=live # Set to test when using a Paystack test secret key
PAYSTACK_SECRET_KEY=sk_live_replace-me
RESEND_API_KEY=
EMAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generated-code sandbox: use independent random secrets (32+ characters).
SANDBOX_RUNNER_URL=http://localhost:3031
SANDBOX_RUNNER_TOKEN=replace-with-independent-random-secret-at-least-32-characters

# --- Social publishing (Social Scheduler) ---
# Secret that lets the scheduled GitHub Action call /api/cron/publish-scheduled.
# Use at least 16 random characters, e.g. openssl rand -hex 32. Set the same value as the
# CRON_SECRET repository secret. Without it, scheduled posts are never published.
CRON_SECRET=
# Each platform is optional. Leave blank to keep it disabled. Register this callback URL in
# every developer app: <NEXTAUTH_URL>/api/marketing/accounts/oauth/<platform>/callback
# where <platform> is linkedin, x, meta, instagram or tiktok. See SOCIAL-PUBLISHING.md.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# One Meta app serves both Facebook Pages (meta) and Instagram.
META_APP_ID=
META_APP_SECRET=
# Optional: override the Graph API version (default v26.0).
META_GRAPH_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
