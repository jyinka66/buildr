{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "functions": {
    "src/app/api/projects/[id]/generate-stream/route.ts": { "maxDuration": 60 },
    "src/app/api/projects/[id]/generate/route.ts": { "maxDuration": 60 },
    "src/app/api/projects/[id]/refactor/route.ts": { "maxDuration": 60 },
    "src/app/api/projects/[id]/code-review/route.ts": { "maxDuration": 60 },
    "src/app/api/deploy/vercel/route.ts": { "maxDuration": 60 },
    "src/app/api/deploy/netlify/route.ts": { "maxDuration": 60 },
    "src/app/api/import/github/route.ts": { "maxDuration": 60 }
  }
}
